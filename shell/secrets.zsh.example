# 秘密情報(API キー・トークン)の雛形。値は入れずにこのリポジトリに置く。
#
# 使い方:
#   cp shell/secrets.zsh.example ~/.secrets.zsh && chmod 600 ~/.secrets.zsh
#   値を書き込む。setup.sh が ~/.zshenv に読み込み行を足すので、対話シェル・
#   スクリプト・エージェントのどの zsh からも環境変数として使える。
#
# ~/.secrets.zsh は git 管理外。実際の値をこのファイルや shell/.zshrc に書かない。

export GOOGLE_CLOUD_PROJECT=""
export QWEN_API_KEY=""
export ANYTYPE_API_KEY=""
export ROBIT_HUBSPOT_TOKEN_OBJECTS=""
export ROBIT_HUBSPOT_TOKEN_SCHEMAS=""
export ROBIT_HUBSPOT_TOKEN_PIPELINES=""
export ROBIT_HUBSPOT_TOKEN_EMAILS=""
export ROBIT_HUBSPOT_TOKEN_FILES=""
